# ===== Eco Tashkent root .env.example =====
# Har bir papkada (backend/, bot/) o'z .env fayli bor.
# Bu fayl faqat namuna — to'liq ro'yxat uchun backend/.env.example va bot/.env.example ga qarang.

# Backend (backend/.env)
# DATABASE_URL="postgresql://user:password@host:5432/eco_tashkent?schema=public"
# JWT_SECRET="uzun-va-mustahkam-maxfiy-kalit"
# PORT=5000
# CLIENT_URL="http://localhost:5173"

# Bot (bot/.env)
# TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
# API_URL="http://localhost:5000"
# WEB_URL="http://localhost:5173"
